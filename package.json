{
  "name": "sun",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "sun-dev sun bun --hot --preload ./css-plugin.ts server.js",
    "build": "bun run build:client && bun run build:server",
    "postbuild": "command -v sun-notify >/dev/null 2>&1 && sun-notify sun || true",
    "build:client": "bunx vite build --ssrManifest --outDir dist/client",
    "build:server": "bunx vite build --ssr src/entry-server.tsx --outDir dist/server",
    "graphql:generate": "bunx graphql-codegen --config codegen.ts",
    "schema:pull": "bunx graphql-codegen --config codegen.ts",
    "lint": "bunx oxlint",
    "preview": "NODE_ENV=production bun --preload ./css-plugin.ts server.js",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "lint:fix": "bunx oxlint --fix",
    "fmt": "bunx oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "fmt:check": "bunx oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,json}\""
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.5.0",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@sun/analytics": "^0.1.2",
    "@sun/api": "^0.2.9",
    "@sun/components": "0.12.15",
    "@sun/events": "^0.1.1",
    "@sun/i18n": "^0.1.1",
    "@sun/security": "^0.1.9",
    "@sun/shared": "^0.2.12",
    "@sun/ssr": "0.10.1",
    "@sun/themes": "^0.2.12",
    "@sun/utils": "^0.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.9.0",
    "i18next": "^25.0.0",
    "lucide-preact": "1.61.0",
    "preact": "11.0.2",
    "preact-heroicons": "^2.2.0",
    "preact-render-to-string": "^6.8.1",
    "react-router-dom": "^6.22.0",
    "sirv": "^3.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/client-preset": "5.1.1",
    "@graphql-codegen/schema-ast": "^5.0.2",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@preact/preset-vite": "^2.10.6",
    "@sun/build": "^0.2.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.8.0",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "bun-types": "1.4.3",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
