{
  "name": "sun",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "graphql:generate": "graphql-codegen --config codegen.ts",
    "lint": "npx eslint",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "preview": "cross-env NODE_ENV=production tsx --loader ./css-loader.mjs server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/client-preset": "5.1.1",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@swc/core": "^1.15.33",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.8.0",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/http-proxy": "^11.4.4",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@posthog/react": "^1.9.0",
    "@sun/api": "^0.2.6",
    "@sun/components": "^0.11.12",
    "@sun/ssr": "^0.5.18",
    "@sun/utils": "^0.1.10",
    "@vitejs/plugin-react": "^4.4.1",
    "brotli": "^1.3.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5",
    "lucide-react": "^0.554.0",
    "posthog-node": "^5.21.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.22.0"
  }
}
