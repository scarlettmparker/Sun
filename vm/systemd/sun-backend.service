# VM deploy unit. Local dev units come from vm/sun/render-units.ts.

[Unit]
Description=Sun GraphQL Backend
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/sun/backend
EnvironmentFile=/opt/sun/backend/.env
ExecStart=/usr/bin/java -jar sun-graphql.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
