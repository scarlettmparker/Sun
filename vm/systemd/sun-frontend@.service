[Unit]
Description=Sun Frontend (Fastify SSR) on port %i
After=network.target sun-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/sun/web
ExecStart=%h/.bun/bin/bun --preload ./css-plugin.ts server.js
Environment=NODE_ENV=production
Environment=SERVER_PORT=%i
Environment=SUN_ENV=prod
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
