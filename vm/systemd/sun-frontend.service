[Unit]
Description=Sun Frontend (Fastify SSR)
After=network.target sun-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/sun/web
ExecStart=%h/.bun/bin/bun --preload ./css-plugin.ts server.js
Environment=NODE_ENV=production
EnvironmentFile=/opt/sun/web/port
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
