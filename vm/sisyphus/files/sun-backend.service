[Unit]
Description=Sun GraphQL Backend
After=network-online.target postgresql.service redis-server.service permify.service
Wants=network-online.target
Requires=postgresql.service permify.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/sun/backend
EnvironmentFile=/opt/sun/backend/.env
ExecStart=/opt/sun/backend/start.sh
Restart=always
RestartSec=5
TimeoutStopSec=35
MemoryHigh=1400M
MemoryMax=1700M

[Install]
WantedBy=multi-user.target
