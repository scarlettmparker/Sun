{
  "name": "@sun/security",
  "version": "0.1.9",
  "description": "Shared security headers for Sun ecosystem (CSP/HSTS/COOP/Trusted Types)",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./trusted-types": {
      "types": "./dist/trusted-types.d.ts",
      "import": "./dist/trusted-types.mjs",
      "require": "./dist/trusted-types.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.int.scarlettparker.co.uk"
  },
  "scripts": {
    "build": "tsup",
    "publish": "bun publish --registry https://registry.int.scarlettparker.co.uk",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
