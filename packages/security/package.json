{
  "name": "@sun/security",
  "version": "0.1.8",
  "description": "Shared security headers for Sun ecosystem (CSP/HSTS/COOP/Trusted Types)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./trusted-types": {
      "types": "./dist/trusted-types.d.ts",
      "import": "./dist/trusted-types.mjs",
      "require": "./dist/trusted-types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "publish": "npm publish --ignore-scripts --registry https://registry.int.scarlettparker.co.uk",
    "test": "jest --maxWorkers=50%",
    "lint": "npx eslint"
  },
  "publishConfig": {
    "registry": "https://registry.int.scarlettparker.co.uk"
  },
  "devDependencies": {
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
