{
  "name": "@sun/auth",
  "version": "0.1.0",
  "description": "Shared authentication helpers for Sun ecosystem apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "publish": "npm publish --ignore-scripts --registry https://registry.int.scarlettparker.co.uk"
  },
  "publishConfig": {
    "registry": "https://registry.int.scarlettparker.co.uk"
  },
  "peerDependencies": {
    "@sun/ssr": "*",
    "@sun/api": "*",
    "graphql": "*"
  },
  "devDependencies": {
    "@sun/api": "^0.2.7",
    "@sun/ssr": "^0.5.22",
    "graphql": "^16.0.0",
    "tsup": "^8.3.5",
    "typescript": "~5.7.2",
    "fastify": "^5.9.0"
  }
}
