{
  "name": "@sun/themes",
  "version": "0.2.13",
  "description": "Theme loader helpers for Sun applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup",
    "lint": "bunx eslint",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "publish": "bun publish --registry https://registry.int.scarlettparker.co.uk"
  },
  "dependencies": {},
  "devDependencies": {
    "@sun/components": "^0.11.35",
    "@types/react": "^19.1.2",
    "jsdom": "^27.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "peerDependencies": {
    "@sun/components": ">=0.11.35",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.int.scarlettparker.co.uk"
  }
}
