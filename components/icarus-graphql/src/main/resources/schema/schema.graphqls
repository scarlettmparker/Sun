"""A discussion thread attached to a remote object."""
type ForumThread {
  id: String!
  title: String!
  status: ThreadStatus!
  remoteObject: [String!]
  createdAt: DateTime
  updatedAt: DateTime
}

"""A post in a discussion thread."""
type ForumPost {
  id: String!
  threadId: ID!
  parentId: ID
  body: String!
  status: PostStatus!
  upvotes: Int!
  downvotes: Int!
  netScore: Int!
  author: RemoteUser
  myVote: VoteValue
  createdAt: DateTime
  updatedAt: DateTime
}

type PagedForumThreads {
  items: [ForumThread!]!
  pageInfo: PageInfo!
}

type PagedForumPosts {
  items: [ForumPost!]!
  pageInfo: PageInfo!
}

type ForumObjectReference {
  id: ID!
  ownerType: String!
  ownerId: ID!
}

enum ThreadStatus { ACTIVE LOCKED ARCHIVED }
enum PostStatus { ACTIVE HIDDEN DELETED }

input CreateThreadInput {
  title: String!
  remoteObject: String!
}

input CreatePostInput {
  threadId: ID!
  parentId: ID
  body: String!
}

input ForumVoteInput {
  postId: ID!
  value: VoteValue!
}

"""Read operations for forums."""
type IcarusQueries {
  thread(id: ID!): ForumThread
  threadsFor(remoteObject: String!, pagination: PaginationInput): PagedForumThreads!
  posts(threadId: ID!, includeHidden: Boolean, pagination: PaginationInput): PagedForumPosts!
  myVote(postId: ID!): VoteValue
  locateRemoteObjects(ids: [String!]!): [ForumObjectReference!]!
}

type CreateThreadResponse {
  message: String!
  thread: ForumThread!
}

type LockThreadResponse {
  message: String!
  thread: ForumThread!
}

type ArchiveThreadResponse {
  message: String!
  thread: ForumThread!
}

type CreatePostResponse {
  message: String!
  post: ForumPost!
}

type EditPostResponse {
  message: String!
  post: ForumPost!
}

type DeletePostResponse {
  message: String!
  id: ID!
}

type VoteResponse {
  message: String!
  post: ForumPost!
}

type RemoveVoteResponse {
  message: String!
  post: ForumPost!
}

type AttachObjectResponse {
  message: String!
  id: ID!
}

"""Write operations for forums."""
type IcarusMutations {
  createThread(input: CreateThreadInput!): CreateThreadResponse!
  lockThread(id: ID!): LockThreadResponse!
  archiveThread(id: ID!): ArchiveThreadResponse!
  createPost(input: CreatePostInput!): CreatePostResponse!
  editPost(id: ID!, body: String!): EditPostResponse!
  deletePost(id: ID!): DeletePostResponse!
  vote(input: ForumVoteInput!): VoteResponse!
  removeVote(postId: ID!): RemoveVoteResponse!
  attachObject(source: ID!, target: String!): AttachObjectResponse!
}

extend type Query {
  icarusQueries: IcarusQueries!
}

extend type Mutation {
  icarusMutations: IcarusMutations!
}
