"""A reusable checklist item definition, optionally grouped into a category."""
type ChecklistItem {
  id: String!
  name: String!
  description: String
  icon: String
  categoryId: ID
  lifecycleStatus: String!
  createdAt: DateTime
  updatedAt: DateTime
}

"""A dated checklist instance carrying a set of items with per-item status."""
type ChecklistEntry {
  id: String!
  name: String
  dueAt: DateTime
  completedAt: DateTime
  status: String!
  createdAt: DateTime
  updatedAt: DateTime
}

"""A reusable set of items that can seed new checklist entries."""
type ChecklistTemplate {
  id: String!
  name: String!
  description: String
  status: String!
  createdAt: DateTime
  updatedAt: DateTime
}

"""A grouping for checklist items (e.g. chores, work, packing)."""
type ChecklistCategory {
  id: String!
  name: String!
  description: String
  createdAt: DateTime
  updatedAt: DateTime
}

"""An item linked to an entry, carrying its runtime status and ordering."""
type ChecklistEntryItem {
  id: ID!
  entryId: ID!
  itemId: ID!
  name: String
  icon: String
  status: ItemStatus!
  position: Int!
}

"""An item linked to a template, carrying only its ordering position."""
type ChecklistTemplateItem {
  id: ID!
  templateId: ID!
  itemId: ID!
  name: String
  icon: String
  position: Int!
}

"""A page of checklist items."""
type PagedChecklistItems {
  items: [ChecklistItem!]!
  pageInfo: PageInfo!
}

"""A page of items linked to an entry."""
type PagedChecklistEntryItems {
  items: [ChecklistEntryItem!]!
  pageInfo: PageInfo!
}

"""A page of items linked to a template."""
type PagedChecklistTemplateItems {
  items: [ChecklistTemplateItem!]!
  pageInfo: PageInfo!
}

"""Notes and remote-object links for an entry, template, or item."""
type ChecklistDetail {
  ownerId: ID!
  description: String
  remoteObject: [String!]
}

"""The kind of checklist entity that owns a detail."""
enum RemoteObjectType {
  ENTRY
  TEMPLATE
  ITEM
}

"""Status of an item within a checklist entry."""
enum ItemStatus {
  NOT_STARTED
  COMPLETE
  FAILED
  NOT_NEEDED
}

"""
A generic reference returned by locateRemoteObjects: which checklist detail
references a given foreign object.
"""
type RemoteObjectReference {
  id: ID!
  ownerType: RemoteObjectType!
  ownerId: ID!
  description: String
}

input ChecklistItemInput {
  id: ID
  name: String!
  description: String
  categoryId: ID
  lifecycleStatus: String
  icon: String
}

input ChecklistEntryInput {
  id: ID
  name: String
  dueAt: DateTime
  status: String
}

input ChecklistTemplateInput {
  id: ID
  name: String!
  description: String
  status: String
}

input ChecklistCategoryInput {
  id: ID
  name: String!
  description: String
}

"""Result of creating a checklist item."""
type CreateItemResponse {
  message: String!
  item: ChecklistItem!
}

"""Result of saving a checklist item."""
type SaveItemResponse {
  message: String!
  item: ChecklistItem!
}

"""Result of retiring a checklist item."""
type RetireItemResponse {
  message: String!
  item: ChecklistItem!
}

"""Result of creating a checklist category."""
type CreateCategoryResponse {
  message: String!
  category: ChecklistCategory!
}

"""Result of saving a checklist category."""
type SaveCategoryResponse {
  message: String!
  category: ChecklistCategory!
}

"""Result of creating a checklist entry."""
type CreateChecklistResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of creating a checklist entry from a single template."""
type CreateChecklistFromTemplateResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of creating a checklist entry from multiple templates."""
type CreateChecklistFromTemplatesResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of saving a checklist entry."""
type SaveChecklistResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of completing a checklist entry."""
type CompleteChecklistResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of archiving a checklist entry."""
type ArchiveChecklistResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of deleting a checklist entry."""
type DeleteChecklistResponse {
  message: String!
  id: ID!
}

"""Result of creating a checklist template."""
type CreateTemplateResponse {
  message: String!
  template: ChecklistTemplate!
}

"""Result of saving a checklist template."""
type SaveTemplateResponse {
  message: String!
  template: ChecklistTemplate!
}

"""Result of archiving a checklist template."""
type ArchiveTemplateResponse {
  message: String!
  template: ChecklistTemplate!
}

"""Result of adding an item to a checklist entry."""
type AddItemResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of removing an item from a checklist entry."""
type RemoveItemResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of setting an item's status within a checklist entry."""
type SetItemStatusResponse {
  message: String!
  entry: ChecklistEntry!
}

"""Result of adding an item to a checklist template."""
type AddTemplateItemResponse {
  message: String!
  template: ChecklistTemplate!
}

"""Result of removing an item from a checklist template."""
type RemoveTemplateItemResponse {
  message: String!
  template: ChecklistTemplate!
}

"""Result of attaching a remote object to a checklist detail."""
type AttachChecklistObjectResponse {
  message: String!
  id: ID!
}

"""Result of detaching a remote object from a checklist detail."""
type DetachObjectResponse {
  message: String!
  id: ID!
}

"""Read operations for checklists."""
type ChecklistQueries {
  items(pagination: PaginationInput): PagedChecklistItems!
  item(id: ID!): ChecklistItem
  entry(id: ID!): ChecklistEntry
  template(id: ID!): ChecklistTemplate
  templateDetails(id: ID!): ChecklistDetail
  entryDetails(id: ID!): ChecklistDetail
  itemDetails(id: ID!): ChecklistDetail
  templateItems(templateId: ID!, pagination: PaginationInput): PagedChecklistTemplateItems!
  entryItems(entryId: ID!, pagination: PaginationInput): PagedChecklistEntryItems!
  listEntries: [ChecklistEntry!]
  listTemplates: [ChecklistTemplate!]
  listCategories: [ChecklistCategory!]
  locateRemoteObjects(ids: [String!]!): [RemoteObjectReference!]!
}

"""Write operations for checklists."""
type ChecklistMutations {
  createItem(name: String!, description: String, categoryId: ID, icon: String): CreateItemResponse!
  saveItem(input: ChecklistItemInput!): SaveItemResponse!
  retireItem(id: ID!): RetireItemResponse!

  createCategory(name: String!, description: String): CreateCategoryResponse!
  saveCategory(input: ChecklistCategoryInput!): SaveCategoryResponse!

  createChecklist(name: String): CreateChecklistResponse!
  createChecklistFromTemplate(templateId: ID!, name: String): CreateChecklistFromTemplateResponse!
  createChecklistFromTemplates(templateIds: [ID!]!, name: String): CreateChecklistFromTemplatesResponse!
  saveChecklist(input: ChecklistEntryInput!): SaveChecklistResponse!
  completeChecklist(id: ID!): CompleteChecklistResponse!
  archiveChecklist(id: ID!): ArchiveChecklistResponse!
  deleteChecklist(id: ID!): DeleteChecklistResponse!

  createTemplate(name: String!, description: String, itemIds: [ID!]): CreateTemplateResponse!
  saveTemplate(input: ChecklistTemplateInput!): SaveTemplateResponse!
  archiveTemplate(id: ID!): ArchiveTemplateResponse!

  addItem(entryId: ID!, itemId: ID!, position: Int): AddItemResponse!
  removeItem(entryId: ID!, itemId: ID!): RemoveItemResponse!
  setItemStatus(entryId: ID!, itemId: ID!, status: ItemStatus!): SetItemStatusResponse!

  addTemplateItem(templateId: ID!, itemId: ID!, position: Int): AddTemplateItemResponse!
  removeTemplateItem(templateId: ID!, itemId: ID!): RemoveTemplateItemResponse!

  attachObject(source: ID!, target: ID!, ownerType: RemoteObjectType): AttachChecklistObjectResponse!
  detachObject(source: ID!, target: ID!, ownerType: RemoteObjectType): DetachObjectResponse!
}

extend type Query {
  checklistQueries: ChecklistQueries!
}

extend type Mutation {
  checklistMutations: ChecklistMutations!
}
