type Piece {
  id: ID!
  slug: String!
  name: String!
  description: String
  isKing: Boolean!
  promotionTargets: [ID!]
  promotionRanks: [Int!]
  moveStates: JSON
  stateTransition: String!
  edgeReset: Boolean!
  isSystem: Boolean!
  createdBy: ID
  ownerName: String
  createdAt: DateTime
  updatedAt: DateTime
  sprite: PieceSprite
}

type PieceSprite {
  headKey: String!
  bodyKey: String!
  footKey: String!
}

input PieceInput {
  id: ID
  slug: String!
  name: String!
  description: String
  isKing: Boolean!
  promotionTargets: [ID!]
  promotionRanks: [Int!]
  moveStates: JSON
  stateTransition: String!
  edgeReset: Boolean!
  sprite: PieceSpriteInput!
}

input PieceSpriteInput {
  headKey: String!
  bodyKey: String!
  footKey: String!
}

type PieceSet {
  id: ID!
  name: String!
  description: String
  startingFen: String!
  isSystem: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
  members: [PieceSetMember!]!
}

type PieceSetMember {
  slot: String!
  pieceDefinitionId: ID!
}

input PieceSetMemberInput {
  slot: String!
  pieceDefinitionId: ID!
}

input PieceSetInput {
  id: ID
  name: String!
  description: String
  startingFen: String!
  members: [PieceSetMemberInput!]
}

type BoardPlacement {
  definitionId: ID!
  color: Int!
  square: Int!
}

type BoardLayout {
  id: ID!
  slug: String!
  name: String!
  description: String
  placements: [BoardPlacement!]!
  isSystem: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
}

input BoardPlacementInput {
  definitionId: ID!
  color: Int!
  square: Int!
}

input BoardLayoutInput {
  id: ID
  slug: String!
  name: String!
  description: String
  placements: [BoardPlacementInput!]!
}

type AuditLog {
  id: ID!
  createdAt: DateTime
  actorId: ID
  actorEmail: String
  action: String!
  target: String
  outcome: String!
  detail: String
  ip: String
}

type PieceResponse {
  message: String!
  piece: Piece!
}

type PieceSetResponse {
  message: String!
  pieceSet: PieceSet!
}

type BoardLayoutResponse {
  message: String!
  boardLayout: BoardLayout!
}

type DeleteResponse {
  ok: Boolean!
}

type AuditLogPage {
  items: [AuditLog!]!
  total: Int!
}

type GameMove {
  ply: Int!
  move: Long!
  playedAt: DateTime!
}

type Game {
  id: ID!
  code: String!
  boardLayoutId: ID
  boardLayoutName: String!
  status: String!
  initialState: JSON!
  finalState: JSON
  creatorAccountId: ID!
  whiteAccountId: ID
  blackAccountId: ID
  result: String
  winnerAccountId: ID
  moveCount: Int!
  createdAt: DateTime!
  startedAt: DateTime
  finishedAt: DateTime
  archivedAt: DateTime
  moves: [GameMove!]!
}

type GamePage {
  items: [Game!]!
  pageInfo: PageInfo!
}

type GameResponse {
  message: String!
  game: Game!
}

input GameMoveInput {
  ply: Int!
  move: Long!
  playedAt: DateTime!
}

input GameArchiveInput {
  code: String!
  boardLayoutId: ID
  boardLayoutName: String!
  initialState: JSON!
  finalState: JSON!
  creatorAccountId: ID!
  whiteAccountId: ID
  blackAccountId: ID
  result: String
  winnerAccountId: ID
  createdAt: DateTime!
  startedAt: DateTime
  finishedAt: DateTime!
  moves: [GameMoveInput!]!
}

type MedusaQueries {
  pieces(all: Boolean): [Piece!]!
  piece(id: ID!): Piece
  pieceSets: [PieceSet!]!
  pieceSet(id: ID!): PieceSet
  boardLayouts: [BoardLayout!]!
  boardLayout(id: ID!): BoardLayout
  boardLayoutBySlug(slug: String!): BoardLayout
  auditLogs(pagination: PaginationInput): AuditLogPage!
  game(code: String!): Game
  myGames(pagination: PaginationInput): GamePage!
}

type MedusaMutations {
  savePiece(input: PieceInput!): PieceResponse!
  deletePiece(id: ID!): DeleteResponse!
  savePieceSet(input: PieceSetInput!): PieceSetResponse!
  deletePieceSet(id: ID!): DeleteResponse!
  saveBoardLayout(input: BoardLayoutInput!): BoardLayoutResponse!
  deleteBoardLayout(id: ID!): DeleteResponse!
  archiveGame(input: GameArchiveInput!): GameResponse!
}

extend type Query {
  medusaQueries: MedusaQueries!
}

extend type Mutation {
  medusaMutations: MedusaMutations!
}