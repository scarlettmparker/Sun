type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

type AuthResult {
  accountId: ID!
  personId: ID!
  token: String!
}

type ApiKey {
  id: ID!
  name: String!
  keyPrefix: String!
  enabled: Boolean!
  lastUsedAt: DateTime
  createdAt: DateTime
  updatedAt: DateTime
}

type IssuedApiKey {
  apiKey: ApiKey!
  plaintextKey: String!
}

input RegisterInput {
  username: String!
  password: String!
  firstName: String!
  lastName: String!
  email: String!
  displayName: String
}

input LoginInput {
  username: String!
  password: String!
}

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

enum HubMode {
  dev
  serve
}

type HubApp {
  key: String!
  name: String!
  dir: String!
  devPort: Int!
  prodPort: Int!
  url: String!
  description: String!
  enabled: Boolean!
  self: Boolean!
}

type HubRegistry {
  mode: HubMode!
  apps: [HubApp!]!
}

input HubAppInput {
  key: String!
  name: String!
  dir: String!
  devPort: Int!
  prodPort: Int!
  url: String!
  description: String!
  enabled: Boolean!
  self: Boolean!
}

input HubRegistryInput {
  mode: HubMode!
  apps: [HubAppInput!]!
}

type Role {
  id: ID!
  name: String!
  description: String
  createdAt: DateTime
  updatedAt: DateTime
}

type GaiaQueries {
  me: Account
  account(id: ID!): Account
  listAccounts: [Account!]
  myRoles: [String!]!
  accounts(pagination: PaginationInput): PagedAccounts!
  roles: [Role!]!
  role(id: ID!): Role
  accountRoles(accountId: ID!): [String!]!
  accountPermissions(accountId: ID!): [String!]!
  rolePermissions(roleId: ID!): [String!]!
  allPermissions: [String!]!
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  propertySets(ownerKey: String!, name: String!): [PropertySetEntry!]!
  propertySetSchema(ownerKey: String!, name: String!): PropertySetSchema
  propertySetSchemas(ownerKey: String): [PropertySetSchema!]!
  configurations: [Configuration!]!
  configuration(id: ID!): Configuration
  ipWhitelistEntries: [IpWhitelistEntry!]!
  tailscaleDevices: [TailscaleDevice!]!
  tailscaleDevice(id: ID!): TailscaleDevice
  hubRegistry: HubRegistry
  effectivePermissions(remoteUserType: RemoteUserType!, remoteUserId: String!): [String!]!
  accessibleCommandIntents(
    remoteUserType: RemoteUserType!
    remoteUserId: String!
    ownerKey: String!
    propertySet: String!
  ): [PropertySetEntry!]!
}

type LogoutResponse {
  message: String!
}

type SuspendAccountResponse {
  message: String!
  account: Account!
}

type UnsuspendAccountResponse {
  message: String!
  account: Account!
}

type CreateRoleResponse {
  message: String!
  role: Role!
}

type DeleteRoleResponse {
  message: String!
  id: ID!
}

type SetAccountRolesResponse {
  message: String!
  accountId: ID!
  roles: [String!]!
}

type SetAccountPermissionsResponse {
  message: String!
  accountId: ID!
  permissions: [String!]!
}

type SetRolePermissionsResponse {
  message: String!
  roleId: ID!
  permissions: [String!]!
}

type DeactivateAccountResponse {
  message: String!
}

type RequestAccountReactivationResponse {
  message: String!
}

type ConfirmAccountReactivationResponse {
  message: String!
}

type RequestPasswordResetResponse {
  message: String!
}

type ResetPasswordResponse {
  message: String!
}

type ChangePasswordResponse {
  message: String!
}

type UpsertPropertyEntryResponse {
  message: String!
  entry: PropertySetEntry!
}

type SetPropertyResponse {
  message: String!
  entry: PropertySetEntry!
}

type RegisterPropertySetSchemaResponse {
  message: String!
  schema: PropertySetSchema!
}

type DeletePropertyEntryResponse {
  message: String!
  id: ID!
}

type IssueApiKeyResponse {
  message: String!
  apiKey: IssuedApiKey!
}

type RevokeApiKeyResponse {
  message: String!
  id: ID!
}

type RotateApiKeyResponse {
  message: String!
  apiKey: IssuedApiKey!
}

type CreateConfigurationResponse {
  message: String!
  configuration: Configuration!
}

type UpdateConfigurationResponse {
  message: String!
  configuration: Configuration!
}

type DeleteConfigurationResponse {
  message: String!
  id: ID!
}

type ApplyConfigurationResponse {
  message: String!
  configuration: Configuration!
}

type CreateIpWhitelistEntryResponse {
  message: String!
  entry: IpWhitelistEntry!
}

type UpdateIpWhitelistEntryResponse {
  message: String!
  entry: IpWhitelistEntry!
}

type DeleteIpWhitelistEntryResponse {
  message: String!
  id: ID!
}

type ExpireTailscaleDeviceResponse {
  message: String!
  device: TailscaleDevice!
}

type SaveRegistryResponse {
  message: String!
  registry: HubRegistry!
}

type GaiaMutations {
  register(input: RegisterInput!): AuthResult
  login(input: LoginInput!): AuthResult
  logout: LogoutResponse!
  suspendAccount(id: ID!): SuspendAccountResponse!
  unsuspendAccount(id: ID!): UnsuspendAccountResponse!
  createRole(name: String!, description: String): CreateRoleResponse!
  deleteRole(id: ID!): DeleteRoleResponse!
  setAccountRoles(accountId: ID!, roleNames: [String!]!): SetAccountRolesResponse!
  setAccountPermissions(accountId: ID!, permissions: [String!]!): SetAccountPermissionsResponse!
  setRolePermissions(roleId: ID!, permissions: [String!]!): SetRolePermissionsResponse!
  deactivateAccount: DeactivateAccountResponse!
  requestAccountReactivation(email: String!, provider: String!): RequestAccountReactivationResponse!
  confirmAccountReactivation(token: String!): ConfirmAccountReactivationResponse!
  requestPasswordReset(email: String!): RequestPasswordResetResponse!
  resetPassword(token: String!, newPassword: String!): ResetPasswordResponse!
  changePassword(currentPassword: String!, newPassword: String!): ChangePasswordResponse!
  upsertPropertyEntry(
    ownerKey: String!
    name: String!
    entry: String!
    input: UpsertPropertyEntryInput!
  ): UpsertPropertyEntryResponse!
  setProperty(
    ownerKey: String!
    name: String!
    entry: String!
    input: SetPropertyInput!
  ): SetPropertyResponse!
  registerPropertySetSchema(input: PropertySetSchemaInput!): RegisterPropertySetSchemaResponse!
  deletePropertyEntry(ownerKey: String!, name: String!, entry: String!): DeletePropertyEntryResponse!
  issueApiKey(accountUsername: String!, name: String!): IssueApiKeyResponse!
  revokeApiKey(id: ID!): RevokeApiKeyResponse!
  rotateApiKey(id: ID!): RotateApiKeyResponse!
  createConfiguration(input: ConfigurationInput!): CreateConfigurationResponse!
  updateConfiguration(id: ID!, input: ConfigurationInput!): UpdateConfigurationResponse!
  deleteConfiguration(id: ID!): DeleteConfigurationResponse!
  applyConfiguration(id: ID!): ApplyConfigurationResponse!
  createIpWhitelistEntry(input: IpWhitelistEntryInput!): CreateIpWhitelistEntryResponse!
  updateIpWhitelistEntry(id: ID!, input: IpWhitelistEntryInput!): UpdateIpWhitelistEntryResponse!
  deleteIpWhitelistEntry(id: ID!): DeleteIpWhitelistEntryResponse!
  expireTailscaleDevice(id: ID!): ExpireTailscaleDeviceResponse!
  saveRegistry(input: HubRegistryInput!): SaveRegistryResponse!
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}

enum EntryStatus {
  ACTIVE
  ARCHIVED
}

type PropertySetEntry {
  id: String!
  ownerKey: String!
  propertySet: String!
  entryName: String!
  values: JSON!
  configurable: Boolean!
  status: EntryStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

type PropertySetSchema {
  id: String!
  ownerKey: String
  name: String!
  properties: JSON!
  configurable: Boolean!
  status: EntryStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

type Configuration {
  id: String!
  name: String!
  description: String
  enabled: Boolean!
  content: JSON!
  lastAppliedAt: DateTime
  lastApplyError: String
  createdAt: DateTime
  updatedAt: DateTime
}

input PropertySetSchemaInput {
  ownerKey: String
  name: String!
  configurable: Boolean
  properties: JSON!
}

input UpsertPropertyEntryInput {
  values: JSON!
}

input SetPropertyInput {
  property: String!
  value: JSON!
}

type IpWhitelistEntry {
  id: ID!
  pattern: String!
  description: String
  enabled: Boolean!
  immutable: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
}

input IpWhitelistEntryInput {
  pattern: String!
  description: String
  immutable: Boolean
  enabled: Boolean
}

enum DeviceStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

type TailscaleDevice {
  id: ID!
  headscaleId: Long!
  name: String!
  ipv4: String
  status: DeviceStatus!
  online: Boolean!
  expiredAt: DateTime
  lastSeen: String
  createdAt: DateTime
  updatedAt: DateTime
}

input ConfigurationInput {
  name: String!
  description: String
  enabled: Boolean
  content: JSON!
}
