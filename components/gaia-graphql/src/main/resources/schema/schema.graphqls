type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  remoteUsers: [RemoteUser!]
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DEACTIVATED
}

type AuthResult {
  accountId: ID!
  personId: ID!
  token: String!
}

type ApiKey {
  id: ID!
  name: String!
  keyPrefix: String!
  enabled: Boolean!
  lastUsedAt: DateTime
  createdAt: DateTime
  updatedAt: DateTime
}

type IssuedApiKey {
  apiKey: ApiKey!
  plaintextKey: String!
}

input RegisterInput {
  username: String!
  password: String!
  firstName: String!
  lastName: String!
  email: String!
  displayName: String
}

input LoginInput {
  username: String!
  password: String!
}

type PagedAccounts {
  items: [Account!]!
  pageInfo: PageInfo!
}

enum HubMode {
  dev
  serve
}

type HubApp {
  key: String!
  name: String!
  dir: String!
  devPort: Int!
  prodPort: Int!
  url: String!
  description: String!
  enabled: Boolean!
  self: Boolean!
}

type HubRegistry {
  mode: HubMode!
  apps: [HubApp!]!
}

input HubAppInput {
  key: String!
  name: String!
  dir: String!
  devPort: Int!
  prodPort: Int!
  url: String!
  description: String!
  enabled: Boolean!
  self: Boolean!
}

input HubRegistryInput {
  mode: HubMode!
  apps: [HubAppInput!]!
}

type Role {
  id: ID!
  name: String!
  description: String
  createdAt: DateTime
  updatedAt: DateTime
}

type GaiaQueries {
  me: Account
  account(id: ID!): Account
  listAccounts: [Account!]
  myRoles: [String!]!
  accounts(pagination: PaginationInput): PagedAccounts!
  roles: [Role!]!
  role(id: ID!): Role
  accountRoles(accountId: ID!): [String!]!
  accountPermissions(accountId: ID!): [String!]!
  rolePermissions(roleId: ID!): [String!]!
  allPermissions: [String!]!
  propertySet(ownerKey: String!, name: String!, entry: String): JSON
  propertySets(ownerKey: String!, name: String!): [PropertySetEntry!]!
  propertySetSchema(ownerKey: String!, name: String!): PropertySetSchema
  propertySetSchemas(ownerKey: String): [PropertySetSchema!]!
  configurations: [Configuration!]!
  configuration(id: ID!): Configuration
  ipWhitelistEntries: [IpWhitelistEntry!]!
  tailscaleDevices: [TailscaleDevice!]!
  tailscaleDevice(id: ID!): TailscaleDevice
  hubRegistry: HubRegistry
  effectivePermissions(remoteUserType: RemoteUserType!, remoteUserId: String!): [String!]!
  accessibleCommandIntents(
    remoteUserType: RemoteUserType!
    remoteUserId: String!
    ownerKey: String!
    propertySet: String!
  ): [PropertySetEntry!]!
}

type GaiaMutations {
  register(input: RegisterInput!): AuthResult
  login(input: LoginInput!): AuthResult
  logout: QueryResult
  suspendAccount(id: ID!): QueryResult
  unsuspendAccount(id: ID!): QueryResult
  createRole(name: String!, description: String): Role
  deleteRole(id: ID!): QueryResult
  setAccountRoles(accountId: ID!, roleNames: [String!]!): QueryResult
  setAccountPermissions(accountId: ID!, permissions: [String!]!): QueryResult
  setRolePermissions(roleId: ID!, permissions: [String!]!): QueryResult
  deactivateAccount: QueryResult
  requestAccountReactivation(email: String!, provider: String!): QueryResult
  confirmAccountReactivation(token: String!): QueryResult
  requestPasswordReset(email: String!): QueryResult
  resetPassword(token: String!, newPassword: String!): QueryResult
  changePassword(currentPassword: String!, newPassword: String!): QueryResult
  upsertPropertyEntry(
    ownerKey: String!
    name: String!
    entry: String!
    input: UpsertPropertyEntryInput!
  ): PropertySetEntry
  setProperty(
    ownerKey: String!
    name: String!
    entry: String!
    input: SetPropertyInput!
  ): PropertySetEntry
  registerPropertySetSchema(input: PropertySetSchemaInput!): PropertySetSchema
  deletePropertyEntry(ownerKey: String!, name: String!, entry: String!): QueryResult
  issueApiKey(accountUsername: String!, name: String!): IssuedApiKey
  revokeApiKey(id: ID!): QueryResult
  rotateApiKey(id: ID!): IssuedApiKey
  createConfiguration(input: ConfigurationInput!): Configuration
  updateConfiguration(id: ID!, input: ConfigurationInput!): Configuration
  deleteConfiguration(id: ID!): QueryResult
  applyConfiguration(id: ID!): Configuration
  createIpWhitelistEntry(input: IpWhitelistEntryInput!): QueryResult
  updateIpWhitelistEntry(id: ID!, input: IpWhitelistEntryInput!): QueryResult
  deleteIpWhitelistEntry(id: ID!): QueryResult
  expireTailscaleDevice(id: ID!): QueryResult
  saveRegistry(input: HubRegistryInput!): HubRegistry
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}

enum EntryStatus {
  ACTIVE
  ARCHIVED
}

type PropertySetEntry {
  id: String!
  ownerKey: String!
  propertySet: String!
  entryName: String!
  values: JSON!
  configurable: Boolean!
  status: EntryStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

type PropertySetSchema {
  id: String!
  ownerKey: String
  name: String!
  properties: JSON!
  configurable: Boolean!
  status: EntryStatus!
  createdAt: DateTime
  updatedAt: DateTime
}

type Configuration {
  id: String!
  name: String!
  description: String
  enabled: Boolean!
  content: JSON!
  lastAppliedAt: DateTime
  lastApplyError: String
  createdAt: DateTime
  updatedAt: DateTime
}

input PropertySetSchemaInput {
  ownerKey: String
  name: String!
  configurable: Boolean
  properties: JSON!
}

input UpsertPropertyEntryInput {
  values: JSON!
}

input SetPropertyInput {
  property: String!
  value: JSON!
}

type IpWhitelistEntry {
  id: ID!
  pattern: String!
  description: String
  enabled: Boolean!
  immutable: Boolean!
  createdAt: DateTime
  updatedAt: DateTime
}

input IpWhitelistEntryInput {
  pattern: String!
  description: String
  immutable: Boolean
  enabled: Boolean
}

enum DeviceStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

type TailscaleDevice {
  id: ID!
  headscaleId: Long!
  name: String!
  ipv4: String
  status: DeviceStatus!
  online: Boolean!
  expiredAt: DateTime
  lastSeen: String
  createdAt: DateTime
  updatedAt: DateTime
}

input ConfigurationInput {
  name: String!
  description: String
  enabled: Boolean
  content: JSON!
}
