type BlogPostType {
  id: ID!
  name: String!
  description: String
}

type BlogPost {
  id: String!
  title: String!
  content: String
  tags: [String!]
  remoteObject: [String!]
  type: BlogPostType
  language: String
  parentId: ID
  parent: BlogPost
  attachedTexts: [AttachedText!]
  createdAt: DateTime
  updatedAt: DateTime
}

type AttachedText {
  id: String!
  title: String!
  language: String!
  level: String!
  status: String!
}

input BlogPostInput {
  content: String
  tags: [String!]
  remoteObject: [String!]
  typeId: ID
  language: String
  parentId: ID
}

type PagedBlogPosts {
  items: [BlogPost!]!
  pageInfo: PageInfo!
}

type BlogPropertySetSchema {
  id: ID!
  ownerKey: String
  name: String!
  properties: JSON
}

type BlogPropertySet {
  schema: BlogPropertySetSchema
  values: JSON
  entryName: String!
}

type BlogGalleryItem {
  id: ID!
  title: String
  imagePath: String
  remoteObject: [String!]
}

type BlogDetail {
  post: BlogPost!
  propertySet: BlogPropertySet
  galleryItems: [BlogGalleryItem!]!
  attachedTexts: [AttachedText!]!
  linkedPosts: [BlogPost!]!
}

input BlogWithPropertiesInput {
  title: String!
  content: String!
  typeId: ID!
  parentId: ID
  language: String
  tags: [String!]
  remoteObject: [String!]
  propertySet: JSON
}

type BlogQueries {
  listBlogPosts(pagination: PaginationInput): PagedBlogPosts!
  locateBlogPost(id: ID!): BlogPost
  listByRemoteObjects(ids: [String!]!): [BlogPost]
  blogPostTypes: [BlogPostType!]!
  children(parentId: ID!, pagination: PaginationInput): PagedBlogPosts!
  blogDetail(id: ID!): BlogDetail!
}

enum SourceKind {
  WIKIPEDIA
  WIKTIONARY
}

type Summary {
  title: String!
  extract: String
  pageUrl: String
  thumbnailUrl: String
}

type Entry {
  word: String!
  definitions: [String!]!
  sourceUrl: String
}

type RelatedTopic {
  title: String!
  pageUrl: String!
  extract: String
}

type WikiQueries {
  wikipediaSummary(title: String!): Summary
  wikipediaPage(title: String!): String
  wiktionaryEntry(word: String!): Entry
  wikipediaRelatedTopics(title: String!): [RelatedTopic!]!
  wikipediaSearch(query: String!): [Summary!]!
}

input IngestBlogInput {
  title: String!
  typeName: String!
  sourceKind: SourceKind!
  sourceId: String!
  parentId: ID
}

type CreateBlogPostResponse {
  message: String!
  post: BlogPost!
}

type UpdateBlogPostResponse {
  message: String!
  post: BlogPost!
}

type CreateBlogPostTypeResponse {
  message: String!
  type: BlogPostType!
}

type AddRemoteObjectResponse {
  message: String!
  post: BlogPost!
}

type RemoveRemoteObjectResponse {
  message: String!
  post: BlogPost!
}

type IngestBlogFromSourceResponse {
  message: String!
  post: BlogPost!
}

type DeleteBlogPostResponse {
  message: String!
  id: ID!
}

type CreateBlogWithPropertiesResponse {
  message: String!
  post: BlogPost!
}

type UpdateBlogWithPropertiesResponse {
  message: String!
  post: BlogPost!
}

type BlogMutations {
  createBlogPost(title: String!, input: BlogPostInput): CreateBlogPostResponse!
  updateBlogPost(id: ID!, input: BlogPostInput!): UpdateBlogPostResponse!
  createBlogPostType(name: String!, description: String): CreateBlogPostTypeResponse!
  addRemoteObject(postId: ID!, target: String!): AddRemoteObjectResponse!
  removeRemoteObject(postId: ID!, target: String!): RemoveRemoteObjectResponse!
  ingestBlogFromSource(input: IngestBlogInput!): IngestBlogFromSourceResponse!
  deleteBlogPost(id: ID!): DeleteBlogPostResponse!
  createBlogWithProperties(input: BlogWithPropertiesInput!): CreateBlogWithPropertiesResponse!
  updateBlogWithProperties(id: ID!, input: BlogWithPropertiesInput!): UpdateBlogWithPropertiesResponse!
}

extend type Query {
  blogQueries: BlogQueries!
  wikiQueries: WikiQueries!
}

extend type Mutation {
  blogMutations: BlogMutations!
}
